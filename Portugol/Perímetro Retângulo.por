programa {
  funcao inicio() {
    real lado1, lado2, perimetro
    escreva("Perímetro do retângulo\n")
    escreva("Digite o comprimento do retângulo: ")
    leia (lado1)
    escreva("Digite a altura do retângulo: ")
    leia (lado2)
    perimetro = (lado1 * 2) + (lado2 * 2)

    escreva("O perimetro do retângulo é: ", perimetro)
  }
}
